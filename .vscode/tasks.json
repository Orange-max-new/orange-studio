{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "一键发布：Git push + 同步服务器",
      "type": "shell",
      "command": "python",
      "args": ["scripts/deploy_dual.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "一键发布（含自动提交）",
      "type": "shell",
      "command": "python",
      "args": ["scripts/deploy_dual.py", "-m", "deploy: pitch-site"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    },
    {
      "label": "仅同步服务器（跳过 Git）",
      "type": "shell",
      "command": "python",
      "args": ["scripts/deploy_dual.py", "--skip-git"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    },
    {
      "label": "发布预演（dry-run）",
      "type": "shell",
      "command": "python",
      "args": ["scripts/deploy_dual.py", "--dry-run"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    }
  ]
}
